diff --git a/tests/test-dory-loops.cpp b/tests/test-dory-loops.cpp
new file mode 100644
index 0000000..cb4d13a
--- /dev/null
+++ b/tests/test-dory-loops.cpp
@@ -0,0 +1,160 @@
+// Dory runtime loop count: a stock (num_loops=4) context with llama_set_n_loops(k) must match
+// a model loaded with dory.num_loops=k. Usage: test-dory-loops <dory.gguf>
+#include "llama.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); exit(1); } } while (0)
+
+static const int N_PROMPT = 64;
+static const int N_GEN    = 32;
+
+static llama_model * load(const char * path, int num_loops) {
+    llama_model_kv_override ov[2] = {};
+    auto mp = llama_model_default_params();
+    if (num_loops > 0) {
+        ov[0].tag = LLAMA_KV_OVERRIDE_TYPE_INT;
+        strcpy(ov[0].key, "dory.num_loops");
+        ov[0].val_i64 = num_loops;
+        mp.kv_overrides = ov;
+    }
+    llama_model * m = llama_model_load_from_file(path, mp);
+    CHECK(m);
+    return m;
+}
+
+static llama_context * make_ctx(llama_model * m, int32_t n_loops_max) {
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 256;
+    cp.n_batch = N_PROMPT;
+    cp.n_ubatch = N_PROMPT;
+    cp.n_loops_max = n_loops_max;
+    llama_context * c = llama_init_from_model(m, cp);
+    CHECK(c);
+    return c;
+}
+
+static llama_token argmax(const float * l, int n) {
+    return (llama_token) (std::max_element(l, l + n) - l);
+}
+
+// decode the prompt; return last-token logits and the 32 greedy tokens that follow
+static void run(llama_context * c, const std::vector<llama_token> & prompt, std::vector<float> & logits, std::vector<llama_token> & gen) {
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(c)));
+    llama_memory_clear(llama_get_memory(c), true);
+    auto p = prompt;
+    CHECK(llama_decode(c, llama_batch_get_one(p.data(), (int32_t) p.size())) == 0);
+    const float * l = llama_get_logits_ith(c, -1);
+    logits.assign(l, l + n_vocab);
+    gen.clear();
+    llama_token t = argmax(l, n_vocab);
+    for (int i = 0; i < N_GEN; ++i) {
+        gen.push_back(t);
+        CHECK(llama_decode(c, llama_batch_get_one(&t, 1)) == 0);
+        t = argmax(llama_get_logits_ith(c, -1), n_vocab);
+    }
+}
+
+int main(int argc, char ** argv) {
+    CHECK(argc == 2);
+    const char * path = argv[1];
+    llama_backend_init();
+    llama_log_set([](ggml_log_level lvl, const char * msg, void *) { if (lvl >= GGML_LOG_LEVEL_WARN) fputs(msg, stderr); }, nullptr);
+
+    llama_model * stock = load(path, 0);
+    llama_context * b = make_ctx(stock, 0);
+    CHECK(llama_get_n_loops(b) == 4);
+
+    const std::string text =
+        "The quick brown fox jumps over the lazy dog. In a small village by the sea, an old fisherman "
+        "mended his nets every morning while the gulls circled overhead and the children ran along the "
+        "shore collecting shells, counting waves, and telling stories about ships that never came back. "
+        "When evening fell, the lighthouse keeper climbed the spiral stairs, lit the great lamp, and wrote "
+        "in his logbook the names of every vessel that passed the rocks before the tide turned again.";
+    std::vector<llama_token> prompt(256);
+    const int n = llama_tokenize(llama_model_get_vocab(stock), text.c_str(), (int32_t) text.size(), prompt.data(), (int32_t) prompt.size(), true, false);
+    CHECK(n >= N_PROMPT);
+    prompt.resize(N_PROMPT);
+
+    int failed = 0;
+    for (int k : {1, 2, 4}) {
+        llama_model * mk = load(path, k);
+        llama_context * a = make_ctx(mk, 0);
+        CHECK(llama_get_n_loops(a) == k);
+        CHECK(llama_set_n_loops(b, k) == 0);
+        CHECK(llama_get_n_loops(b) == k);
+
+        std::vector<float> la, lb;
+        std::vector<llama_token> ga, gb;
+        run(a, prompt, la, ga);
+        run(b, prompt, lb, gb);
+        float diff = 0.0f;
+        for (size_t i = 0; i < la.size(); ++i) {
+            diff = std::max(diff, std::fabs(la[i] - lb[i]));
+        }
+        const bool ok = diff <= 1e-3f && ga == gb;
+        printf("k=%d max_abs_logit_diff=%g greedy_%d_match=%d %s\n", k, diff, N_GEN, (int) (ga == gb), ok ? "PASS" : "FAIL");
+        failed += !ok;
+        llama_free(a);
+        llama_model_free(mk);
+    }
+
+    // graph reuse across a loop switch: same-shape 1-token decodes at k=1 then k=4 must not share a graph
+    {
+        const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(stock));
+        llama_token t = prompt[0];
+        auto one = [&](llama_context * ctx) {
+            llama_memory_clear(llama_get_memory(ctx), true);
+            CHECK(llama_decode(ctx, llama_batch_get_one(&t, 1)) == 0);
+            const float * l = llama_get_logits_ith(ctx, -1);
+            return std::vector<float>(l, l + n_vocab);
+        };
+        llama_context * r = make_ctx(stock, 0); // fresh k=4
+        const auto want = one(r);
+        llama_free(r);
+        CHECK(llama_set_n_loops(b, 1) == 0);
+        const auto k1 = one(b);
+        CHECK(llama_set_n_loops(b, 4) == 0);
+        const auto got = one(b);
+        float d4 = 0.0f, d1 = 0.0f;
+        for (int i = 0; i < n_vocab; ++i) {
+            d4 = std::max(d4, std::fabs(got[i] - want[i]));
+            d1 = std::max(d1, std::fabs(k1[i] - want[i]));
+        }
+        const bool ok = d4 <= 1e-3f && d1 > 1e-3f;
+        printf("1-token decode after k=1->4 switch: diff vs fresh k=4 %g (k=1 differs by %g) %s\n", d4, d1, ok ? "PASS" : "FAIL");
+        failed += !ok;
+    }
+
+    CHECK(llama_set_n_loops(b, 3) == 0);
+    CHECK(llama_set_n_loops(b, 5) == -1);
+    CHECK(llama_set_n_loops(b, 0) == -1);
+    CHECK(llama_get_n_loops(b) == 3);
+    printf("set_n_loops range checks PASS\n");
+
+    // n_loops_max=1 allocates fewer KV layers: same prompt -> smaller state
+    llama_context * c = make_ctx(stock, 1);
+    CHECK(llama_get_n_loops(c) == 1);
+    CHECK(llama_set_n_loops(c, 2) == -1);
+    std::vector<float> lc;
+    std::vector<llama_token> gc;
+    run(c, prompt, lc, gc);
+    CHECK(llama_set_n_loops(b, 1) == 0);
+    run(b, prompt, lc, gc);
+    const size_t sb = llama_state_get_size(b), sc = llama_state_get_size(c);
+    printf("state size n_loops_max=4: %zu, n_loops_max=1: %zu %s\n", sb, sc, sc < sb ? "PASS" : "FAIL");
+    failed += !(sc < sb);
+
+    llama_free(c);
+    llama_free(b);
+    llama_model_free(stock);
+    llama_backend_free();
+    printf(failed ? "FAILED\n" : "ALL PASS\n");
+    return failed ? 1 : 0;
+}
